---
// Books grouped by status (reading / to-read). No tags, by design.
import { useTranslations } from "../i18n/index.js";
import { BOOK_STATUSES, getBooks } from "../lib/content.js";

const { lang, limit } = Astro.props;
const t = useTranslations(lang);
const groups = getBooks(lang);
---

<div class="books">
  {
    BOOK_STATUSES.map((status) => {
      const books = limit ? groups[status].slice(0, limit) : groups[status];
      return (
        <section class={`bookgroup bookgroup-${status}`} id={`books-${status}`}>
          <h5 class="px">{t(`books.${status}`)}</h5>
          {books.length ? (
            <ul>
              {books.map((b) => (
                <li>
                  <span class="bcover">{b.cover && <img src={b.cover} alt="" loading="lazy" />}</span>
                  <span class="binfo">
                    <span class="btitle">{b.title}</span>
                    {b.author && <span class="bauthor">{b.author}</span>}
                    {b.year && <span class="bauthor"> · {b.year}</span>}
                    {b.note && <span class="note">{b.note}</span>}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">{t("books.empty")}</p>
          )}
        </section>
      );
    })
  }
</div>
