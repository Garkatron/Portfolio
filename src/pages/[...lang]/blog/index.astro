---
import Base from "../../../layout/Base.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { localeParams, useTranslations } from "../../../i18n/index.js";
import { getPosts } from "../../../lib/content.js";

export const getStaticPaths = localeParams;

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getPosts(lang);
const fmt = new Intl.DateTimeFormat(lang, { year: "numeric", month: "2-digit", day: "2-digit" });
---

<Base lang={lang} page="blog" title={t("blog.title")} description={t("blog.intro")}>
  <PageHeader kicker={`// ${t("files.blog")}`} title={t("blog.title")} intro={t("blog.intro")} />
  {
    posts.length ? (
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <a href={p.href} data-log="open" data-log-arg={`blog/${p.slug}/index.md`}>
              <time datetime={p.date.toISOString()}>{fmt.format(p.date)}</time>
              <span>
                <span class="post-title">{p.title}</span>
                {p.description && <span class="post-desc">{p.description}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">{t("blog.empty")}</p>
    )
  }
</Base>
